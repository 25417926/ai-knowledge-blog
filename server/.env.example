# Python 后端（FastAPI）配置。复制为 .env 后按需填写。

# 数据库文件路径，默认项目根 data/blog.db
# DB_PATH=D:/data/blog.db

# 真实 LLM（OpenAI 兼容协议）。不配则走 Mock 模式，全流程照常演示。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# 后台（/admin）登录口令。留空则后台整体禁用，前台不受影响。
# 改口令会让已签发的会话立刻失效（没配 SESSION_SECRET 时签名密钥由口令派生）。
ADMIN_PASSWORD=
# 可选：固定签名密钥。不配就用 ADMIN_PASSWORD 派生，够本地单人用。
# SESSION_SECRET=

# 允许跨域访问的 Next 前端地址
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
