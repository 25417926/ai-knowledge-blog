# Python 后端（FastAPI）配置。复制为 .env 后按需填写。

# 数据库文件路径，默认项目根 data/blog.db
# DB_PATH=D:/data/blog.db

# 真实 LLM（OpenAI 兼容协议）。不配则走 Mock 模式，全流程照常演示。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# 允许跨域访问的 Next 前端地址
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
