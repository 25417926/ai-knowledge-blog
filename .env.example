# 数据库文件路径，默认 ./data/blog.db
DB_PATH=

# Obsidian Vault 目录，默认 content/sample-vault
VAULT_DIR=

# ---- 阶段 3 起使用：LLM 接入 ----
# 留空则走 Mock 模式，全流程可跑通，无需任何 Key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 向量模型（用于 RAG 检索），留空时降级为关键词检索
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 后台管理密码（阶段 2 使用）
ADMIN_PASSWORD=
