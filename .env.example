# 数据库文件路径，默认 ./data/blog.db
DB_PATH=

# Obsidian Vault 目录，默认 content/sample-vault
VAULT_DIR=

# ---- 阶段 3 起使用：LLM 接入 ----
# 留空则走 Mock 模式，全流程可跑通，无需任何 Key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 向量召回（可选，默认关）----
# 全留空 = 只走关键词检索，不依赖任何外部进程，装完就能跑。
# 要开语义召回，下面五项必须**一起**给：只填地址和模型名不会生效（PROVIDER 默认 none）。
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# 后台管理密码（阶段 2 使用）
ADMIN_PASSWORD=
